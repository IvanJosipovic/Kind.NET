<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Kind.NET</PackageId>
    <Authors>Ivan Josipovic</Authors>
    <Description>Kubernetes in Docker for .NET</Description>
    <PackageTags>KIND Kubernetes Docker</PackageTags>
    <RepositoryUrl>https://github.com/IvanJosipovic/Kind.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>
    <KindVersion>v0.33.0</KindVersion>
    <KindAssetRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</KindAssetRid>
    <KindAssetRid Condition="'$(KindAssetRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</KindAssetRid>
    <KindExecutableExtension Condition="'$(KindAssetRid)' == 'win-x64' or '$(KindAssetRid)' == 'win-arm64'">.exe</KindExecutableExtension>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kind.NET.Tests" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="runtimes\win-x64\native\kind.exe" Pack="true" PackagePath="runtimes/win-x64/native/" />
    <None Include="runtimes\win-arm64\native\kind.exe" Pack="true" PackagePath="runtimes/win-arm64/native/" />
    <None Include="runtimes\linux-x64\native\kind" Pack="true" PackagePath="runtimes/linux-x64/native/" />
    <None Include="runtimes\linux-arm64\native\kind" Pack="true" PackagePath="runtimes/linux-arm64/native/" />
    <None Include="runtimes\osx-x64\native\kind" Pack="true" PackagePath="runtimes/osx-x64/native/" />
    <None Include="runtimes\osx-arm64\native\kind" Pack="true" PackagePath="runtimes/osx-arm64/native/" />
    <Content Include="runtimes\$(KindAssetRid)\native\kind$(KindExecutableExtension)"
             Link="runtimes\$(KindAssetRid)\native\kind$(KindExecutableExtension)"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest"
             Pack="false"
             Condition="Exists('runtimes\$(KindAssetRid)\native\kind$(KindExecutableExtension)')" />
  </ItemGroup>

</Project>
