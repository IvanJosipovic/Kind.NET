<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Kind.NET</PackageId>
    <Authors>Ivan Josipovic</Authors>
    <Description>Kubernetes in Docker for .NET</Description>
    <PackageTags>KIND Kubernetes Docker</PackageTags>
    <RepositoryUrl>https://github.com/IvanJosipovic/Kind.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</IsAotCompatible>
    <VerifyReferenceAotCompatibility Condition="$([MSBuild]::IsTargetFrameworkCompatible('$(TargetFramework)', 'net8.0'))">true</VerifyReferenceAotCompatibility>
    <KindVersion>v0.33.0</KindVersion>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kind.NET.Tests" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="runtimes\win-x64\native\kind.exe" Pack="true" PackagePath="runtimes/win-x64/native/" CopyToOutputDirectory="PreserveNewest" />
    <None Include="runtimes\win-arm64\native\kind.exe" Pack="true" PackagePath="runtimes/win-arm64/native/" CopyToOutputDirectory="PreserveNewest" />
    <None Include="runtimes\linux-x64\native\kind" Pack="true" PackagePath="runtimes/linux-x64/native/" CopyToOutputDirectory="PreserveNewest" />
    <None Include="runtimes\linux-arm64\native\kind" Pack="true" PackagePath="runtimes/linux-arm64/native/" CopyToOutputDirectory="PreserveNewest" />
    <None Include="runtimes\osx-x64\native\kind" Pack="true" PackagePath="runtimes/osx-x64/native/" CopyToOutputDirectory="PreserveNewest" />
    <None Include="runtimes\osx-arm64\native\kind" Pack="true" PackagePath="runtimes/osx-arm64/native/" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
