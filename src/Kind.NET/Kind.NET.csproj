<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Kind.NET</PackageId>
    <Authors>Ivan Josipovic</Authors>
    <Description>Kubernetes in Docker for .NET</Description>
    <PackageTags>KIND Kubernetes Docker</PackageTags>
    <RepositoryUrl>https://github.com/IvanJosipovic/Kind.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <KindVersion>v0.33.0</KindVersion>
    <KindAssetRid>$(RuntimeIdentifier)</KindAssetRid>
    <KindAssetRid Condition="'$(KindAssetRid)' == ''">$(NETCoreSdkRuntimeIdentifier)</KindAssetRid>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kind.NET.Tests" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="runtimes\**\native\*"
          Pack="true"
          PackagePath="runtimes/" />
    <None Update="runtimes\$(KindAssetRid)\native\*"
          Link="%(Identity)"
          CopyToOutputDirectory="PreserveNewest"
          CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
