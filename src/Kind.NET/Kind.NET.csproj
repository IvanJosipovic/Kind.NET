<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <PackageId>Kind.NET</PackageId>
    <Authors>Ivan Josipovic</Authors>
    <Description>Kubernetes in Docker for .NET</Description>
    <PackageTags>KIND Kubernetes Docker</PackageTags>
    <RepositoryUrl>https://github.com/IvanJosipovic/Kind.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <VerifyReferenceAotCompatibility>true</VerifyReferenceAotCompatibility>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kind.NET.Tests" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="runtimes/**/native/kindshim.dll" Pack="true" CopyToOutputDirectory="PreserveNewest" PackagePath="%(Identity)" />
    <None Include="runtimes/**/native/libkindshim.so" Pack="true" CopyToOutputDirectory="PreserveNewest" PackagePath="%(Identity)" />
    <None Include="runtimes/**/native/libkindshim.dylib" Pack="true" CopyToOutputDirectory="PreserveNewest" PackagePath="%(Identity)" />
  </ItemGroup>
</Project>
